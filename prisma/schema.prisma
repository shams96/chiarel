generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  slug        String   @id
  sku         String   @unique
  name        String
  descriptor  String
  step        String
  ritualOrder Int?
  family      String
  colorName   String
  colorHex    String
  complex     String
  line        String
  size        String
  priceSub    Int
  priceOneTime Int
  image       String
  blurb       String
  role        String?
  badge       String?
  isSet       Boolean  @default(false)
  isIcon      Boolean  @default(false)
  actives     Json?

  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id          String  @id @default(cuid())
  cart        Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId      String
  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
  mode        String
  qty         Int     @default(1)

  @@unique([cartId, productSlug])
}

model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  status          String      @default("pending")
  stripeSessionId String?     @unique
  email           String
  firstName     String
  lastName      String
  address       String
  city          String
  state         String
  zip           String
  subtotal      Int
  savings       Int
  shipping      Int
  total         Int
  // Set at checkout when subtotal crossed the bonus-sample threshold (see
  // EXTRA_SAMPLE_THRESHOLD in app/api/checkout/route.ts). Fulfillment-facing
  // only — deliberately not shown to the customer on the order page, so the
  // extra sample stays a surprise when they open the box.
  bonusSample   Boolean     @default(false)
  items         OrderItem[]

  // Dispute/chargeback risk mitigation — see claudedocs/specs/dispute-risk-mitigation/.
  // termsAcceptedAt/termsVersion is the checkout consent record: real evidence for
  // Stripe's "Refund policy details" dispute-response field, not just a UI checkbox.
  termsAcceptedAt DateTime?
  termsVersion    String?
  // Flat fields on Order rather than a separate Dispute table/relation — a dispute
  // always maps to exactly one order and doesn't need its own history of state
  // transitions here (Stripe's own dashboard is the audit trail for that).
  // PaymentIntent id, not charge id — Stripe's Dispute object exposes
  // `payment_intent` directly, so matching on that avoids an extra charge lookup.
  stripePaymentIntentId String?
  disputeId       String?   @unique
  disputeStatus   String?
  disputeReason   String?
  disputeAmount   Int?
  disputeOpenedAt DateTime?
  disputeClosedAt DateTime?
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
  mode        String
  qty         Int
  unitPrice   Int
}

model FoundingSignup {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String
  email      String
  phone      String?
  social     String?
  referredBy String?
  source     String?
}

// Internal/admin RBAC — see claudedocs/specs/admin-rbac/. Distinct from customer
// orders above: these are accounts for people operating the business (Admin/Member/
// Viewer), not customers, who never authenticate at all (guest checkout only).
enum Role {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  email        String    @unique
  passwordHash String
  role         Role
  sessions     Session[]
}

// DB-backed rather than a stateless JWT so a role change or account cutoff takes
// effect immediately (delete the row) instead of waiting out a token's expiry.
model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

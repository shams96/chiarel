# Supabase Postgres. DATABASE_URL is the pooled (pgbouncer, transaction
# mode) connection the running app uses for normal queries. DIRECT_URL is
# the unpooled connection Prisma Migrate needs (pgbouncer's transaction mode
# breaks the prepared statements migrations rely on).
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Stripe. Use the sk_test_/pk_test_ pair while developing; swap to the
# sk_live_/pk_live_ pair only when actually taking real payments.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the Stripe CLI (`stripe listen`) locally, or the webhook endpoint's
# signing secret in the Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — Founding 100 signups still save to the database without this;
# set it to also forward each signup to an external CRM/Slack/Zapier
# webhook. Leave unset in local dev.
FOUNDING_LIST_WEBHOOK_URL=

# Admin RBAC (claudedocs/specs/admin-rbac/). Set both to bootstrap the first Admin
# account via `npm run db:seed` — deliberately no baked-in default credentials.
# Leave unset after the first Admin exists; further accounts are created by that
# Admin via /admin/users, not by re-running the seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Used to sign/verify the admin session cookie's HMAC (see lib/auth.ts). Generate
# with `openssl rand -base64 32` — a real secret, never a placeholder, before this
# ever runs somewhere reachable.
ADMIN_SESSION_SECRET=

# Hostinger's included SMTP email service (claudedocs/specs/dispute-risk-mitigation/) —
# used only for the dispute-rate threshold-warning alert. Find these in hPanel under
# Emails > your mailbox > Configuration (Outgoing/SMTP server, port, username, password).
HOSTINGER_SMTP_HOST=
HOSTINGER_SMTP_PORT=
HOSTINGER_SMTP_USER=
HOSTINGER_SMTP_PASS=
# Where the threshold-warning alert is sent — defaults to ORDERS_EMAIL (lib/seo.ts)
# if unset; only set this to override that.
DISPUTE_ALERT_EMAIL=
